PORT=8000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_hex_string
PAYMENT_SECRET=
# Your deployed frontend URL(s), comma-separated (a trailing "/" is fine)
# Example: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# Optional: set NODE_ENV=production on your host (Render does this for Node services)
# NODE_ENV=production
